# PLC Configuration - REAL HARDWARE ONLY
PLC_SIMULATION_MODE=false
PLC_COM_PORT=COM5
PLC_BAUD_RATE=38400
PLC_STATION_ID=1

# Database Configuration
DATABASE_SIMULATION_MODE=false
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=eol_tester
MYSQL_USER=root
MYSQL_PASSWORD=password

# Debug Settings
DEBUG_MODE=true
ENABLE_CONSOLE_OUTPUT=true

# Support Account
# Employee number of the support login. It needs a row in EMPLOYEE_INFO so it
# shows in the dropdown, but its password is checked against the hash below
# instead of the PASSWORD column. Generate one with: python auth.py "<password>"
SERVICE_ACCOUNT_USER=
SERVICE_ACCOUNT_PASSWORD_HASH=
